# ─── Database ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aiserver
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aiserver_db

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend ─────────────────────────────────────────────────
PORT=4000
# Must match the origin browsers use to reach the portal.
# With nginx + mkcert (dev and prod): https://portal.lan
# Local-only without nginx:           http://localhost:5173
FRONTEND_URL=https://portal.lan
NODE_ENV=development

# ─── Discord ─────────────────────────────────────────────────
DISCORD_WEBHOOK_SCHEDULE=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_TASKS=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_REPORTS=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_TICKETS=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_FILES=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ─── File Uploads ────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# ─── Mail (password reset emails) ─────────────────────────────
# Leave SMTP_HOST empty to print reset links to the server log instead
# (development / LAN-only). For a real mailbox, fill in your SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AI/ML Lab Portal <no-reply@portal.lan>"
# Public origin of the portal, used to build password-reset links.
# Example: https://portal.lan — falls back to FRONTEND_URL / request origin.
APP_BASE_URL=

# ── Site addressing ──────────────────────────────────────────────────────
# The three values that change when this server moves to another network.
# Nothing else in the repository names an address.

# This machine LAN address. CoreDNS binds to it and answers PUBLIC_HOST with
# it, so the lab keeps working when the uplink does not.
WIFI_IP=192.168.1.10

# The public hostname served through the Cloudflare Tunnel.
PUBLIC_HOST=portal.example.com

# The site router. CoreDNS asks it first, so a change of ISP needs no edit
# here: the router learns the upstream resolver by DHCP on whatever uplink
# it is plugged into.
ROUTER_IP=192.168.1.1

# Cloudflare Tunnel token, from Zero Trust -> Networks -> Tunnels -> your
# tunnel -> Install connector. It carries the tunnel identity: treat it as a
# password. The tunnel dials outbound, so no port forwarding is needed and
# the same token keeps working from any network.
TUNNEL_TOKEN=
