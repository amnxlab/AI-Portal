# TLS certificates — private keys must never be committed.
# Run  sudo bash scripts/setup-ssl.sh  to populate this directory.
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.pem

# Allow the placeholder so the directory itself is tracked
!nginx/certs/.gitkeep

# Dev environment
node_modules/
dist/
.env
*.log

# Local data, backups and large binaries — not source
backups/
documentations/
uploads/
video_tutorials/
backend/uploads/
backend/video_tutorials/
launcher/
migration/
frontend/build/
*.pid
.deploy-stamp
*.png
*.ico
!frontend/public/**
!frontend/src/assets/**
!backend/assets/**

# A backup of .env holds the same secrets as .env; the certs
# directory holds a private key; .cf-token is the DNS API token.
.env.*
!.env.example
*.bak-*
.cf-token
