## Database Schema (ERD)

```sql
-- USERS & AUTH
users (id UUID PK, username TEXT UNIQUE, email TEXT UNIQUE,
       password_hash TEXT, role TEXT CHECK IN ('Admin','Manager','Employee','Inventory_Manager'),
       is_active BOOL DEFAULT true, created_at TIMESTAMPTZ)

refresh_tokens (id UUID PK, user_id UUID FK→users, token TEXT, expires_at TIMESTAMPTZ)

-- SCHEDULING
schedules (id UUID PK, user_id UUID FK→users, week_start DATE,
           shifts JSONB,   -- [{day, start, end, note}]
           submitted_at TIMESTAMPTZ, discord_posted BOOL DEFAULT false)

-- INVENTORY
inventory_items (id UUID PK, name TEXT, category TEXT, description TEXT,
                 quantity INT, unit TEXT, status TEXT, location TEXT,
                 photo_url TEXT, created_by UUID FK→users, updated_at TIMESTAMPTZ)

inventory_logs (id UUID PK, item_id UUID FK→inventory_items, user_id UUID FK→users,
                action TEXT CHECK IN ('check_in','check_out','update'),
                quantity_delta INT, notes TEXT, logged_at TIMESTAMPTZ)

-- PROJECTS & TASKS
projects (id UUID PK, name TEXT, description TEXT, status TEXT,
          start_date DATE, end_date DATE, budget NUMERIC(12,2),
          owner_id UUID FK→users, created_at TIMESTAMPTZ)

sub_projects (id UUID PK, project_id UUID FK→projects, name TEXT, description TEXT)

tasks (id UUID PK, project_id UUID FK→projects, sub_project_id UUID FK→sub_projects,
       assignee_id UUID FK→users, created_by UUID FK→users,
       title TEXT, description TEXT, status TEXT CHECK IN ('Todo','In Progress','Done','Blocked'),
       priority TEXT CHECK IN ('Low','Medium','High','Critical'),
       deadline DATE, estimated_hours NUMERIC, actual_hours NUMERIC,
       attachments JSONB, created_at TIMESTAMPTZ, updated_at TIMESTAMPTZ)

-- WISHLISTS
wishlist_items (id UUID PK, project_id UUID FK→projects, sub_project_id UUID FK→sub_projects,
                item_name TEXT, description TEXT, cost NUMERIC(10,2),
                link TEXT, status TEXT CHECK IN ('Requested','Approved','Purchased','Rejected'),
                requested_by UUID FK→users, created_at TIMESTAMPTZ)

-- WEEKLY REPORTS
weekly_reports (id UUID PK, user_id UUID FK→users, week_start DATE,
                tasks_hours JSONB,  -- [{task_id, task_title, hours, notes}]
                total_hours NUMERIC, submitted_at TIMESTAMPTZ, status TEXT CHECK IN ('Draft','Submitted'))

-- AUDIT TRAIL
audit_logs (id UUID PK, actor_id UUID FK→users, entity_type TEXT,
            entity_id UUID, action TEXT, old_value JSONB, new_value JSONB,
            timestamp TIMESTAMPTZ DEFAULT now())

-- Indexes
CREATE INDEX idx_tasks_assignee ON tasks(assignee_id);
CREATE INDEX idx_tasks_project ON tasks(project_id);
CREATE INDEX idx_schedules_week ON schedules(week_start);
CREATE INDEX idx_reports_user_week ON weekly_reports(user_id, week_start);
CREATE INDEX idx_inventory_category ON inventory_items(category);
CREATE INDEX idx_audit_entity ON audit_logs(entity_type, entity_id);
```

